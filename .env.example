# Pseudo config template. This file IS committed, so it must never hold a real key.
# Make your own copy (gitignored) and fill it in:
#   Copy-Item .env.example .env

# pseudo_brain (M16) reads only LLM_API_KEY from here: its URLs and models live in
# pseudo_brain/providers.toml (D10, D16). LLM_BASE_URL and LLM_MODEL are for the playground (M1-M3).

# Provider: Groq free tier, using its OpenAI-compatible endpoint. No card needed.
# Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-groq-key-here

# Model: openai/gpt-oss-120b supports tool calling and is on Groq's free plan.
# Checked 2026-09-27: 30 requests/min, 1K requests/day, 8K tokens/min, 200K tokens/day.
# Faster, smaller alternative with the same free limits: openai/gpt-oss-20b
# Free tiers change often; re-check https://console.groq.com/docs/rate-limits before M1.
LLM_MODEL=openai/gpt-oss-120b

# (M30, D26) The email of YOUR Claude account (the subscription Claude Code is logged into).
# Before every action request, Pseudo checks that Claude Code is logged into exactly this account.
# It is compared, never printed, logged or sent anywhere. Left empty, action requests are refused.
CLAUDE_CODE_ACCOUNT=
