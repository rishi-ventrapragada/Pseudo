# Virtual environment: rebuilt from requirements.txt, never committed (like node_modules)
.venv/

# Real secrets. Only .env.example (the template) is committed.
.env

# Python bytecode cache, regenerated automatically
__pycache__/

# pytest's own cache (remembers failed tests between runs)
.pytest_cache/

# The agent's sandbox: whatever the agent writes stays local.
# The .gitkeep line keeps the empty folder itself in git.
playground/sandbox/*
!playground/sandbox/.gitkeep
